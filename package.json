{
  "name": "semantic_analyser",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "js2sol": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --skipLibCheck",
    "start": "node dist/index.js",
    "compile": "node dist/index.js compile",
    "dev": "tsc --skipLibCheck && node dist/index.js compile",
    "demo": "tsc --skipLibCheck && node dist/index.js demo",
    "app": "tsc --skipLibCheck && node dist/index.js",
    "web": "tsc --skipLibCheck && node dist/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "compiler",
    "solidity",
    "javascript",
    "smart-contracts",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "description": "JavaScript to Solidity compiler with semantic analysis",
  "dependencies": {
    "@types/node": "^25.2.3",
    "express": "^4.18.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2"
  }
}
